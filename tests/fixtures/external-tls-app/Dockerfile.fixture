FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production NPM_CONFIG_CACHE=/tmp/npm-cache NPM_CONFIG_UPDATE_NOTIFIER=false CHECKPOINT_DISABLE=1
RUN echo '{"name":"deps","private":true}' > package.json && npm install --no-audit --no-fund prisma@7.10.1 pg@8.23.1 && rm -rf /tmp/npm-cache
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY db ./db
COPY server.mjs package.json ./
ARG FIXTURE_WEAK=0
ENV FIXTURE_WEAK=$FIXTURE_WEAK
RUN chown -R node:node /app
USER node
EXPOSE 3000
CMD ["sh", "-c", "npm --silent run db:deploy && npm --silent run db:seed && exec node server.mjs"]
