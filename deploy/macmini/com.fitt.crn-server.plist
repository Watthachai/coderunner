<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by install-agent.sh, which fills in __REPO__ and __HOME__. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.fitt.crn-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__REPO__/deploy/macmini/crn-server.sh</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/crn-launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/crn-launchd.log</string>
</dict>
</plist>
